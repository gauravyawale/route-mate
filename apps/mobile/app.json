{
  "expo": {
    "name": "Route Mate",
    "slug": "route-mate",
    "extra": {
      "eas": {
        "projectId": "f1640c28-6d7b-44de-99df-37d013c9c700"
      },
      "router": {}
    },
    "version": "1.0.0",
    "scheme": "routemate",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.routemate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDybBbNoxC8PfzJtI7FTe1lg_VITiGftP0"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.gauravyawalesorganization.routemate"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withGoogleServices",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Route Mate to use your location to find rides near you."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ]
    ],
    "owner": "gaurav-yawales-organization"
  }
}
