{
  "name": "@route-mate/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest",
    "migrate:up": "tsx --env-file=.env src/infrastructure/db/migrator.ts up",
    "migrate:down": "tsx --env-file=.env src/infrastructure/db/migrator.ts down",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.1081.0",
    "@fastify/cors": "9",
    "@fastify/helmet": "11",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "9",
    "@route-mate/shared": "*",
    "@types/node-pg-migrate": "^2.3.1",
    "bullmq": "^5.0.0",
    "fastify": "^4.26.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "razorpay": "^2.9.6",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "umzug": "^3.8.3",
    "uuid": "^14.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
