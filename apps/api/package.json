{
  "name": "@route-mate/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "migrate:up": "tsx --env-file=.env src/infrastructure/db/migrator.ts up",
    "migrate:down": "tsx --env-file=.env src/infrastructure/db/migrator.ts down"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@route-mate/shared": "*",
    "@types/node-pg-migrate": "^2.3.1",
    "bullmq": "^5.0.0",
    "fastify": "^4.26.0",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "socket.io": "^4.7.0",
    "umzug": "^3.8.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
